diff --git a/nlprompt/datasets/attr_bank.py b/nlprompt/datasets/attr_bank.py
new file mode 100644
index 0000000000000000000000000000000000000000..c4d45f47637b04396cc1829526bcae9011abf153
--- /dev/null
+++ b/nlprompt/datasets/attr_bank.py
@@ -0,0 +1,108 @@
+"""Attribute bank utilities for OTP-CLIP."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+from typing import Dict, Iterable, List, Mapping, Sequence
+
+import yaml
+
+
+def _read_json_or_yaml(path: Path) -> Mapping:
+    """Read a JSON or YAML file into a mapping."""
+
+    with path.open("r", encoding="utf-8") as handle:
+        if path.suffix.lower() in {".yaml", ".yml"}:
+            return yaml.safe_load(handle)
+        return json.load(handle)
+
+
+def load_attr_bank(path: str | Path) -> Dict[str, List[str]]:
+    """Load the attribute bank from *path*.
+
+    The file is expected to contain a mapping from class names to lists of
+    textual attributes. JSON and YAML formats are supported.
+    """
+
+    path = Path(path)
+    if not path.exists():
+        raise FileNotFoundError(f"Attribute bank file not found: {path}")
+
+    data = _read_json_or_yaml(path)
+    if not isinstance(data, Mapping):
+        raise ValueError("Attribute bank must be a mapping from class to attributes")
+
+    result: Dict[str, List[str]] = {}
+    for cls, attrs in data.items():
+        if attrs is None:
+            result[str(cls)] = []
+            continue
+        if isinstance(attrs, str):
+            attrs = [attrs]
+        if not isinstance(attrs, Iterable):
+            raise ValueError(f"Attributes for {cls!r} must be iterable")
+        clean_attrs: List[str] = []
+        for attr in attrs:
+            if attr is None:
+                continue
+            clean_attrs.append(str(attr).strip())
+        result[str(cls)] = [a for a in clean_attrs if a]
+    return result
+
+
+def build_text_templates(
+    class_name: str,
+    attrs: Sequence[str],
+    config: Mapping | None = None,
+) -> List[str]:
+    """Create text templates for the given class and attributes.
+
+    Parameters
+    ----------
+    class_name:
+        Name of the class, typically matching the dataset label.
+    attrs:
+        Sequence of attribute strings.
+    config:
+        Optional configuration mapping that can specify the template
+        construction strategy. Supported keys:
+
+        ``use_attributes`` (bool, default: True)
+            Whether to include attribute sentences.
+        ``class_template`` (str, default: "a photo of a {class}.")
+            Template applied to the class name.
+        ``attr_template`` (str, default: "it is {attr}.")
+            Template applied to each attribute when ``use_attributes`` is
+            enabled.
+        ``joiner`` (str, default: " ")
+            String used to join the class template with attribute sentences.
+    """
+
+    if config is None:
+        config = {}
+
+    use_attrs = bool(config.get("use_attributes", True))
+    class_template = config.get("class_template", "a photo of a {class}.")
+    attr_template = config.get("attr_template", "it is {attr}.")
+    joiner = config.get("joiner", " ")
+
+    templates: List[str] = []
+    class_prompt = class_template.format(class_name=class_name)
+    templates.append(class_prompt)
+
+    if use_attrs and attrs:
+        for attr in attrs:
+            templates.append(
+                joiner.join(
+                    [
+                        class_prompt,
+                        attr_template.format(attr=attr, class_name=class_name),
+                    ]
+                )
+            )
+
+    return templates
+
+
+__all__ = ["load_attr_bank", "build_text_templates"]
