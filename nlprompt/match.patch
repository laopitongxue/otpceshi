@@ -0,0 +1,38 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+CONFIG="nlprompt/configs/otpclip_caltech101.yaml"
+DATASET="caltech101"
+FEWSHOT=16
+ENABLE_MTA=true
+ENABLE_OT=true
+ROBUST="mae"
+
+while [[ $# -gt 0 ]]; do
+  case "$1" in
+    --config)
+      CONFIG="$2"; shift 2 ;;
+    --dataset)
+      DATASET="$2"; shift 2 ;;
+    --few-shot)
+      FEWSHOT="$2"; shift 2 ;;
+    --enable-mta)
+      ENABLE_MTA=true; shift ;;
+    --disable-mta|--no-mta)
+      ENABLE_MTA=false; shift ;;
+    --enable-ot)
+      ENABLE_OT=true; shift ;;
+    --disable-ot|--no-ot)
+      ENABLE_OT=false; shift ;;
+    --robust)
+      ROBUST="$2"; shift 2 ;;
+    *)
+      echo "Unknown argument: $1" >&2
+      exit 1 ;;
+  esac
+done
+
+python train.py \
+  --config-file "$CONFIG" \
+  --dataset-config-file "configs/datasets/${DATASET}.yaml" \
+  TRAINER.OTPCLIP.robust "$ROBUST"
