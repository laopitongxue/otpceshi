diff --git a/nlprompt/trainers/modules/mta.py b/nlprompt/trainers/modules/mta.py
new file mode 100644
index 0000000000000000000000000000000000000000..72f9044c1d3358556f92f4afebc988ac1e1af00f
--- /dev/null
+++ b/nlprompt/trainers/modules/mta.py
@@ -0,0 +1,47 @@
+"""Mean-shift multi-view aggregation module."""
+
+from __future__ import annotations
+
+from typing import Dict, Tuple
+
+import torch
+import torch.nn as nn
+import torch.nn.functional as F
+
+
+class MeanShiftAggregator(nn.Module):
+    """Aggregates multi-view features using mean-shift style updates."""
+
+    def __init__(self, h: float = 0.7, T: int = 5, lam: float = 0.1, entropy: bool = True, train_grad: bool = False) -> None:
+        super().__init__()
+        self.h = h
+        self.T = T
+        self.lam = lam
+        self.entropy = entropy
+        self.train_grad = train_grad
+
+    def forward(self, feats: torch.Tensor) -> Tuple[torch.Tensor, torch.Tensor]:
+        if feats.dim() != 3:
+            raise ValueError("Expected [B, V, D] input")
+        B, V, D = feats.shape
+        proto = feats.mean(dim=1)
+        weights = torch.full((B, V), 1.0 / V, device=feats.device, dtype=feats.dtype)
+
+        def _step(m: torch.Tensor, w: torch.Tensor) -> Tuple[torch.Tensor, torch.Tensor]:
+            diff = (feats - m.unsqueeze(1)).pow(2).sum(dim=-1)
+            logits = -diff / (2 * (self.h ** 2) * max(self.lam, 1e-6))
+            w = torch.softmax(logits, dim=-1)
+            m = torch.sum(feats * w.unsqueeze(-1), dim=1)
+            m = F.normalize(m, dim=-1)
+            return m, w
+
+        ctx = torch.enable_grad() if self.train_grad else torch.no_grad()
+        with ctx:
+            m = proto
+            w = weights
+            for _ in range(self.T):
+                m, w = _step(m, w)
+        return m, w
+
+
+__all__ = ["MeanShiftAggregator"]
diff --git a/nlprompt/trainers/modules/oprompt.py b/nlprompt/trainers/modules/oprompt.py
new file mode 100644
index 0000000000000000000000000000000000000000..8371f68bc8403f925634a29100069761d37707cf
--- /dev/null
+++ b/nlprompt/trainers/modules/oprompt.py
@@ -0,0 +1,120 @@
+"""Learnable prompt aggregation with sparsity and orthogonality regularizers."""
+
+from __future__ import annotations
+
+from typing import Dict, Iterable, List, Mapping, Optional
+
+import torch
+import torch.nn as nn
+import torch.nn.functional as F
+
+
+class OPrompt(nn.Module):
+    """Attribute-aware prompt learner.
+
+    The module aggregates attribute embeddings for each class using
+    learnable weights while providing sparsity and orthogonality
+    regularisation terms that can be consumed by the trainer.
+    """
+
+    def __init__(
+        self,
+        n_ctx: int,
+        attr_embeddings: Mapping[str, torch.Tensor] | None = None,
+        sparsity_lambda: float = 0.0,
+        group_lambda: float = 0.0,
+        orth_lambda: float = 0.0,
+        norm: str | None = None,
+        device: Optional[torch.device] = None,
+    ) -> None:
+        super().__init__()
+        self.n_ctx = n_ctx
+        self.attr_embeddings = attr_embeddings
+        self.sparsity_lambda = sparsity_lambda
+        self.group_lambda = group_lambda
+        self.orth_lambda = orth_lambda
+        self.norm = norm
+        self.device = device
+
+        self.register_buffer("_reg_sparsity", torch.tensor(0.0))
+        self.register_buffer("_reg_orth", torch.tensor(0.0))
+        self.register_buffer("_reg_group", torch.tensor(0.0))
+
+        if attr_embeddings is not None:
+            self._build_parameters(attr_embeddings)
+        else:
+            self.W = None
+
+    def _build_parameters(self, attr_embeddings: Mapping[str, torch.Tensor]) -> None:
+        weights: List[torch.Tensor] = []
+        for _, emb in attr_embeddings.items():
+            n_attr = emb.shape[0]
+            w = torch.zeros((self.n_ctx, n_attr), dtype=emb.dtype, device=emb.device)
+            nn.init.normal_(w, std=0.02)
+            weights.append(w)
+        self.W = nn.ParameterList([nn.Parameter(w) for w in weights])
+
+    def attach_embeddings(self, attr_embeddings: Mapping[str, torch.Tensor]) -> None:
+        self.attr_embeddings = attr_embeddings
+        self._build_parameters(attr_embeddings)
+
+    def forward(self, attr_embeddings: Mapping[str, torch.Tensor]) -> torch.Tensor:
+        if self.W is None or len(self.W) != len(attr_embeddings):
+            self.attach_embeddings(attr_embeddings)
+
+        ctx_list: List[torch.Tensor] = []
+        reg_s = 0.0
+        reg_g = 0.0
+        reg_o = 0.0
+
+        for (cls_idx, (_, emb)), weight in zip(enumerate(attr_embeddings.items()), self.W):
+            if emb.ndim != 2:
+                raise ValueError("Attribute embeddings must have shape [n_attr, dim]")
+            logits = weight
+            if self.norm == "row_l1":
+                attn = torch.softmax(logits, dim=-1)
+            elif self.norm == "none" or self.norm is None:
+                attn = torch.softmax(logits, dim=-1)
+            else:
+                raise ValueError(f"Unsupported normalisation: {self.norm}")
+            ctx = attn @ emb
+            ctx_list.append(ctx.unsqueeze(0))
+
+            reg_s = reg_s + torch.sum(attn.abs())
+            reg_g = reg_g + torch.norm(attn, dim=-1).sum()
+
+        ctx_tensor = torch.stack(ctx_list, dim=0)
+
+        if ctx_tensor.ndim != 3:
+            raise RuntimeError("Context tensor must have shape [C, n_ctx, dim]")
+
+        if self.orth_lambda > 0:
+            c = ctx_tensor.shape[0]
+            flat = ctx_tensor.view(c, -1)
+            gram = F.normalize(flat, dim=-1) @ F.normalize(flat, dim=-1).t()
+            reg_o = (gram - torch.eye(c, device=gram.device, dtype=gram.dtype)).abs().mean()
+
+        self._reg_sparsity = reg_s.detach()
+        self._reg_group = reg_g.detach()
+        self._reg_orth = reg_o.detach()
+
+        self._last_reg = (
+            self.sparsity_lambda * reg_s
+            + self.group_lambda * reg_g
+            + self.orth_lambda * reg_o
+        )
+        return ctx_tensor
+
+    def regularization(self) -> torch.Tensor:
+        return getattr(self, "_last_reg", torch.tensor(0.0, device=self.W[0].device if self.W else None))
+
+    def reg_summary(self) -> Dict[str, float]:
+        device = self._reg_sparsity.device
+        return {
+            "prompt_sparsity": float(self._reg_sparsity.detach().cpu()),
+            "prompt_group": float(self._reg_group.detach().cpu()),
+            "prompt_orth": float(self._reg_orth.detach().cpu()),
+        }
+
+
+__all__ = ["OPrompt"]
diff --git a/nlprompt/trainers/modules/ot.py b/nlprompt/trainers/modules/ot.py
new file mode 100644
index 0000000000000000000000000000000000000000..92d55d744bbaf37b3fc852d74020072b7f8fad5d
--- /dev/null
+++ b/nlprompt/trainers/modules/ot.py
@@ -0,0 +1,43 @@
+"""Wrapper around Sinkhorn-based optimal transport sample filtering."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Optional, Tuple
+
+import torch
+
+
+def sinkhorn(logits: torch.Tensor, n_iter: int = 10, epsilon: float = 0.1) -> torch.Tensor:
+    P = torch.exp(logits / max(epsilon, 1e-6))
+    u = torch.ones(P.size(0), device=P.device, dtype=P.dtype)
+    v = torch.ones(P.size(1), device=P.device, dtype=P.dtype)
+    for _ in range(n_iter):
+        u = 1.0 / (P @ v)
+        v = 1.0 / (P.t() @ u)
+    return torch.diag(u) @ P @ torch.diag(v)
+
+
+@dataclass
+class OTConfig:
+    sinkhorn_iter: int = 20
+    tau_clean: float = 0.5
+    temperature: float = 0.07
+    epsilon: float = 0.1
+
+
+class OTFilter:
+    def __init__(self, cfg: Optional[OTConfig] = None) -> None:
+        self.cfg = cfg or OTConfig()
+
+    def forward(self, sim: torch.Tensor) -> Tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
+        P = sinkhorn(sim / self.cfg.temperature, self.cfg.sinkhorn_iter, self.cfg.epsilon)
+        conf, _ = P.max(dim=1)
+        clean_mask = conf >= self.cfg.tau_clean
+        ot_loss = -torch.log(conf + 1e-6).mean()
+        return clean_mask, conf, ot_loss
+
+    __call__ = forward
+
+
+__all__ = ["OTFilter", "OTConfig"]
diff --git a/nlprompt/trainers/modules/prompt_noise.py b/nlprompt/trainers/modules/prompt_noise.py
