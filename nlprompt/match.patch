@@ -0,0 +1,55 @@
+"""Metrics helpers for OTP-CLIP."""
+
+from __future__ import annotations
+
+from typing import Dict, Iterable
+
+import torch
+import torch.nn.functional as F
+
+
+class MetricCollection:
+    def __init__(self) -> None:
+        self.storage: Dict[str, torch.Tensor] = {}
+
+    def update(self, name: str, value: torch.Tensor) -> None:
+        self.storage[name] = value.detach()
+
+    def compute(self) -> Dict[str, float]:
+        return {k: float(v.mean().cpu()) for k, v in self.storage.items()}
+
+
+def topk_accuracy(logits: torch.Tensor, target: torch.Tensor, topk: Iterable[int] = (1,)) -> Dict[str, float]:
+    maxk = max(topk)
+    _, pred = logits.topk(maxk, dim=1, largest=True, sorted=True)
+    pred = pred.t()
+    correct = pred.eq(target.view(1, -1).expand_as(pred))
+    res = {}
+    for k in topk:
+        correct_k = correct[:k].reshape(-1).float().sum(0, keepdim=True)
+        res[f"acc@{k}"] = float(correct_k.mul_(1.0 / target.size(0)))
+    return res
+
+
+def expected_calibration_error(logits: torch.Tensor, target: torch.Tensor, n_bins: int = 15) -> float:
+    probs = F.softmax(logits, dim=-1)
+    confidences, predictions = probs.max(dim=1)
+    accuracies = predictions.eq(target)
+    bins = torch.linspace(0, 1, n_bins + 1, device=logits.device)
+    ece = torch.zeros(1, device=logits.device)
+    for i in range(n_bins):
+        mask = (confidences > bins[i]) & (confidences <= bins[i + 1])
+        if mask.any():
+            acc = accuracies[mask].float().mean()
+            conf = confidences[mask].mean()
+            ece += (mask.float().mean()) * torch.abs(acc - conf)
+    return float(ece.cpu())
+
+
+def brier_score(logits: torch.Tensor, target: torch.Tensor) -> float:
+    probs = F.softmax(logits, dim=-1)
+    y = F.one_hot(target, logits.size(-1)).float()
+    return float(torch.mean((probs - y).pow(2)).cpu())
+
+
+__all__ = ["MetricCollection", "topk_accuracy", "expected_calibration_error", "brier_score"]
