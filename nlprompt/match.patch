index 0000000000000000000000000000000000000000..e0db88f7330242036321cdda043538285c083c34
--- /dev/null
+++ b/nlprompt/trainers/modules/prompt_noise.py
@@ -0,0 +1,78 @@
+"""Prompt-level Sparse Over-parameterisation noise module."""
+
+from __future__ import annotations
+
+from typing import Dict, Optional
+
+import torch
+import torch.nn as nn
+import torch.nn.functional as F
+
+
+class PromptNoise(nn.Module):
+    """Implements the (s^2 - t^2) noise parameterisation."""
+
+    def __init__(
+        self,
+        granularity: str = "token",
+        s_init: float = 0.05,
+        t_init: float = 0.02,
+        kl_lambda: float = 1e-3,
+        anneal: Optional[Dict[str, float]] = None,
+    ) -> None:
+        super().__init__()
+        self.granularity = granularity
+        self.kl_lambda = kl_lambda
+        self.anneal = anneal or {}
+        self.register_buffer("step", torch.tensor(0.0))
+        self.register_buffer("epoch", torch.tensor(0.0))
+        self.s_init = s_init
+        self.t_init = t_init
+        self.log_s2 = nn.Parameter(torch.tensor([s_init]).log())
+        self.log_t2 = nn.Parameter(torch.tensor([t_init]).log())
+        self.register_buffer("_last_reg", torch.tensor(0.0))
+        self.register_buffer("_last_sigma", torch.tensor(0.0))
+
+    def forward(self, ctx: torch.Tensor, epoch: Optional[int] = None) -> tuple[torch.Tensor, torch.Tensor]:
+        if epoch is not None:
+            self.epoch.fill_(float(epoch))
+        self.step += 1
+
+        sigma2 = self._sigma2(ctx)
+        noise = torch.randn_like(ctx) * torch.sqrt(sigma2)
+        ctx_tilde = ctx + noise
+
+        reg = self.kl_lambda * (self.log_s2.pow(2) + self.log_t2.pow(2))
+        self._last_reg = reg
+        self._last_sigma = sigma2.mean().detach()
+        return ctx_tilde, reg
+
+    def _sigma2(self, ctx: torch.Tensor) -> torch.Tensor:
+        softplus = torch.nn.functional.softplus
+        sigma2 = softplus(self.log_s2) - softplus(self.log_t2)
+        sigma2 = torch.clamp(sigma2, min=1e-6)
+
+        if self.granularity == "token":
+            sigma2 = sigma2.view(1, 1, 1)
+        elif self.granularity == "class":
+            sigma2 = sigma2.view(1, 1, 1)
+        elif self.granularity == "global":
+            sigma2 = sigma2.view(1, 1, 1)
+        else:
+            raise ValueError(f"Unknown granularity: {self.granularity}")
+
+        cap = self.anneal.get("cap_sigma")
+        if cap is not None:
+            sigma2 = torch.clamp(sigma2, max=cap)
+        return sigma2.expand_as(ctx)
+
+    def regularization(self) -> torch.Tensor:
+        return self._last_reg
+
+    def stats(self) -> Dict[str, float]:
+        return {
+            "prompt_noise_sigma": float(self._last_sigma.cpu()),
+        }
+
+
+__all__ = ["PromptNoise"]
