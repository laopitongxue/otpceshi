@@ -0,0 +1,131 @@
+"""OTP-CLIP Trainer integrating SOP, MTA, and OT modules."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Dict, List, Mapping, Optional
+
+import torch
+import torch.nn.functional as F
+
+from dassl.engine import TrainerX
+
+from nlprompt.datasets import load_attr_bank
+from nlprompt.losses import compose_losses
+from nlprompt.trainers.modules import MeanShiftAggregator, OTFilter, OPrompt, PromptNoise
+from nlprompt.utils.metrics import MetricCollection, brier_score, expected_calibration_error, topk_accuracy
+
+
+@dataclass
+class OTPConfig:
+    attr_bank: str
+    prompt_cfg: Mapping
+    prompt_noise_cfg: Mapping
+    mta_cfg: Mapping
+    ot_cfg: Mapping
+    loss_weights: Mapping
+    temperature: float = 0.01
+    robust: str = "mae"
+
+
+class OTPCLIPTrainer(TrainerX):
+    def build_model(self):
+        super().build_model()
+        cfg = self.cfg.TRAINER
+        self.metric_collection = MetricCollection()
+
+        prompt_cfg = cfg.OTPCLIP.PROMPT
+        self.oprompt = OPrompt(
+            n_ctx=prompt_cfg.n_ctx,
+            sparsity_lambda=prompt_cfg.sparsity_lambda,
+            group_lambda=prompt_cfg.group_lambda,
+            orth_lambda=prompt_cfg.orth_lambda,
+            norm=prompt_cfg.norm,
+        ).to(self.device)
+
+        noise_cfg = cfg.OTPCLIP.PROMPT_NOISE
+        self.prompt_noise = PromptNoise(
+            granularity=noise_cfg.granularity,
+            s_init=noise_cfg.s_init,
+            t_init=noise_cfg.t_init,
+            kl_lambda=noise_cfg.kl_lambda,
+            anneal=dict(noise_cfg.anneal),
+        ).to(self.device)
+
+        mta_cfg = cfg.OTPCLIP.MTA
+        self.mta = MeanShiftAggregator(
+            h=mta_cfg.h,
+            T=mta_cfg.T,
+            lam=mta_cfg.lam,
+            entropy=mta_cfg.entropy,
+            train_grad=mta_cfg.train_grad,
+        ).to(self.device)
+
+        ot_cfg = cfg.OTPCLIP.OT
+        self.ot_filter = OTFilter()
+        self.ot_filter.cfg.sinkhorn_iter = ot_cfg.sinkhorn_iter
+        self.ot_filter.cfg.tau_clean = ot_cfg.tau_clean
+        self.ot_filter.cfg.temperature = ot_cfg.temperature
+        self.ot_filter.cfg.epsilon = ot_cfg.epsilon
+
+        self.loss_weights = dict(cfg.OTPCLIP.LOSS_WEIGHTS)
+        self.temperature = cfg.OTPCLIP.get("tau", 0.01)
+        self.robust = cfg.OTPCLIP.get("robust", "mae")
+
+    def before_train(self):
+        super().before_train()
+        attr_bank_path = self.cfg.TRAINER.OTPCLIP.get("attr_bank")
+        self.attr_bank = load_attr_bank(attr_bank_path)
+        self.text_features = None
+
+    def build_text_features(self):
+        class_embeddings = {}
+        for idx, classname in enumerate(self.dm.dataset.classnames):
+            class_embeddings[classname] = self.model.token_embedding(
+                self.dm.texts[idx]
+            )
+        ctx = self.oprompt(class_embeddings)
+        ctx_tilde, noise_reg = self.prompt_noise(ctx)
+        self.text_features = F.normalize(ctx_tilde.mean(dim=1), dim=-1)
+        self.noise_reg = noise_reg
+
+    def forward_backward(self, batch):
+        images, labels = self.parse_batch_train(batch)
+        if self.text_features is None:
+            self.build_text_features()
+
+        feats = self.model.encode_image(images)
+        feats = F.normalize(feats, dim=-1)
+        feats = feats.view(feats.size(0), 1, -1)
+        proto, weights = self.mta(feats)
+        sim = proto @ self.text_features.t()
+        clean_mask, conf, ot_loss = self.ot_filter(sim)
+        logits = sim / self.temperature
+
+        loss, loss_metrics = compose_losses(
+            logits,
+            labels,
+            clean_mask,
+            ot_loss,
+            loss_weights=self.loss_weights,
+            reg_terms=[self.oprompt.regularization(), self.noise_reg],
+            robust_type=self.robust,
+        )
+        self.model_backward_and_update(loss)
+
+        metrics = topk_accuracy(logits, labels, topk=(1,))
+        metrics["ece"] = expected_calibration_error(logits, labels)
+        metrics["brier"] = brier_score(logits, labels)
+        metrics.update(loss_metrics)
+        metrics["ot/conf_mean"] = float(conf.mean().detach().cpu())
+        for name, value in metrics.items():
+            self.write_scalar(name, value, self.iter)
+
+    def model_inference(self, image):
+        feat = self.model.encode_image(image)
+        feat = F.normalize(feat, dim=-1)
+        sim = feat @ self.text_features.t()
+        return sim / self.temperature
+
+
+__all__ = ["OTPCLIPTrainer"]
