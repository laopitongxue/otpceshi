index 0000000000000000000000000000000000000000..c9fde0eda4046665a73c2580230e22abab6cf2fb
--- /dev/null
+++ b/nlprompt/losses/robust_losses.py
@@ -0,0 +1,65 @@
+"""Robust loss composition utilities."""
+
+from __future__ import annotations
+
+from typing import Dict, Optional, Sequence
+
+import torch
+import torch.nn.functional as F
+
+
+def mae_loss(logits: torch.Tensor, target: torch.Tensor) -> torch.Tensor:
+    return torch.abs(F.log_softmax(logits, dim=-1) - F.one_hot(target, logits.size(-1)).float()).sum(dim=-1).mean()
+
+
+def gce_loss(logits: torch.Tensor, target: torch.Tensor, q: float = 0.7) -> torch.Tensor:
+    probs = F.softmax(logits, dim=-1)
+    y = F.one_hot(target, logits.size(-1)).float()
+    p = (probs * y).sum(dim=-1)
+    return (1.0 - p.pow(q)) / q
+
+
+def compose_losses(
+    logits: torch.Tensor,
+    labels: torch.Tensor,
+    clean_mask: torch.Tensor,
+    ot_loss: torch.Tensor,
+    loss_weights: Optional[Dict[str, float]] = None,
+    reg_terms: Optional[Sequence[torch.Tensor]] = None,
+    robust_type: str = "mae",
+) -> tuple[torch.Tensor, Dict[str, float]]:
+    loss_weights = loss_weights or {}
+    reg_terms = [term for term in (reg_terms or []) if term is not None]
+
+    ce = F.cross_entropy(logits[clean_mask], labels[clean_mask]) if clean_mask.any() else torch.tensor(0.0, device=logits.device)
+
+    robust = torch.tensor(0.0, device=logits.device)
+    noisy_mask = ~clean_mask
+    if noisy_mask.any():
+        if robust_type == "mae":
+            robust = mae_loss(logits[noisy_mask], labels[noisy_mask])
+        elif robust_type == "gce":
+            robust = gce_loss(logits[noisy_mask], labels[noisy_mask]).mean()
+        else:
+            raise ValueError(f"Unknown robust loss: {robust_type}")
+
+    reg_sum = torch.stack([r if r.ndim == 0 else r.sum() for r in reg_terms]).sum() if reg_terms else torch.tensor(0.0, device=logits.device)
+
+    loss = (
+        loss_weights.get("ce", 1.0) * ce
+        + loss_weights.get("robust", 0.5) * robust
+        + loss_weights.get("ot", 0.2) * ot_loss
+        + loss_weights.get("reg", 1.0) * reg_sum
+    )
+
+    metrics = {
+        "loss/ce": float(ce.detach().cpu()),
+        "loss/robust": float(robust.detach().cpu()),
+        "loss/ot": float(ot_loss.detach().cpu()),
+        "loss/reg": float(reg_sum.detach().cpu()),
+    }
+
+    return loss, metrics
+
+
+__all__ = ["compose_losses"]
